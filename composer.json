{
  "name": "wexample/symfony-remote-ds",
  "description": "Design-system screens to watch and test the remotes of a Symfony app",
  "type": "library",
  "license": "MIT",
  "version": "4.0.4",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-api": ">=16.0.0",
    "wexample/symfony-design-system": ">=41.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=26.0.0",
    "wexample/symfony-remote": ">=2.0.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}