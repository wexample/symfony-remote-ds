{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {#- One marker per state, rendered here so the script swaps design-system markup instead of rebuilding it. -#}
    {%- set markers = { checking: 'running', up: 'success', down: 'error', unconfigured: 'warning' } -%}
    {%- for state, type in markers -%}
        <template class="remote--marker" data-state="{{ state }}">{{ marker(type, ('@page::state.' ~ state) | trans, { compact: true }) }}</template>
    {%- endfor -%}

    {#- The rows are drawn waiting: each checks itself once the page is up, and
        its state, latency and message are filled in where they stand. -#}
    {%- set rows = [] -%}
    {%- for key, remote in remotes -%}
        {%- set remote_cell -%}
            <span class="text-strong">{{ remote.label }}</span>
            <span class="remote--key text-secondary">{{ key }}</span>
        {%- endset -%}
        {%- set state_cell -%}
            <span class="remote--state" data-remote-key="{{ key }}">{{ marker(markers.checking, '@page::state.checking' | trans, { compact: true }) }}</span>
        {%- endset -%}
        {%- set test_cell -%}
            <button type="button" class="action-icon remote--test"
                    aria-label="{{ '@page::test' | trans }}"
                    data-tooltip="{{ '@page::test' | trans }}">{{ icon('ph:bold/arrows-clockwise') }}</button>
        {%- endset -%}
        {%- set rows = rows | merge([{
            remote: remote_cell,
            state: state_cell,
            latency: '<span class="remote--latency"></span>',
            message: '<span class="remote--message"></span>',
            test: test_cell,
        }]) -%}
    {%- endfor -%}

    <section class="block block--card">
        {{ data_table([
            { key: 'remote', label: '@page::column.remote' | trans, cell: 'html' },
            { key: 'state', label: '@page::column.state' | trans, cell: 'html', class: 'table--cell--nowrap' },
            { key: 'latency', label: '@page::column.latency' | trans, cell: 'html', align: 'right', class: 'table--cell--nowrap' },
            { key: 'message', label: '@page::column.message' | trans, cell: 'html', secondary: true },
            { key: 'test', label: '', cell: 'html', class: 'table--cell--fit' },
        ], rows, {
            striped: true,
            hover: true,
            show_count: true,
            empty_label: '@page::empty' | trans,
        }) }}
    </section>
{%- endblock -%}
